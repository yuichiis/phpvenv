#!/usr/bin/env php
<?php

declare(strict_types=1);

$paths = [
    __DIR__.'/../../../autoload.php',
    __DIR__.'/../vendor/autoload.php',
];
$autoloader = null;
foreach($paths as $path) {
    if(file_exists($path)) {
        $autoloader = $path;
        break;
    }
}
if($autoloader) {
    require_once $autoloader;
} else {
    require_once __DIR__.'/../src/loader.php';
}



use Rindow\PhpVenv\EnvironmentCreator;
use Rindow\PhpVenv\Filesystem;

error_reporting(E_ALL);

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "CLI only.\n");
    exit(1);
}

// Basic usage check
if ($argc < 2) {
    fwrite(STDERR, "Usage: phpvenv <envname>\n");
    exit(1);
}

try {
    $envName = $argv[1];
    $creator = new EnvironmentCreator(new Filesystem());
    $creator->create($envName, getcwd());
    echo "\nDone.\n";
} catch (Exception $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    exit(1);
}
